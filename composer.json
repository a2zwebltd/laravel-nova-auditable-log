{
    "name": "devpartners/auditable-log",
    "description": "A Laravel Nova resource tool for displaying the Laravel Auditing audit log.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.1.0"
    },
    "require-dev": {
        "laravel/nova": "^5.0",
        "laravel/nova-devtool": "^1.7"
    },
    "repositories": [
        { "type": "composer", "url": "https://nova.laravel.com" }
    ],
    "autoload": {
        "psr-4": {
            "Devpartners\\AuditableLog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devpartners\\AuditableLog\\ToolServiceProvider"
            ]
        }
    },
    "suggest": {
        "owen-it/laravel-auditing": "Provides the necessary functionality to audit your Eloquent models"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
